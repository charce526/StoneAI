# 复制为 keystore.properties 后填写本机正式签名信息。
# keystore.properties 已被 .gitignore 排除，请勿提交真实密码或签名文件。
# CI 也可改用 STONEAI_KEYSTORE_FILE、STONEAI_STORE_PASSWORD、
# STONEAI_KEY_ALIAS、STONEAI_KEY_PASSWORD 环境变量。
storeFile=C:/path/to/your/release-key.jks
storePassword=replace-with-your-store-password
keyAlias=replace-with-your-key-alias
keyPassword=replace-with-your-key-password
